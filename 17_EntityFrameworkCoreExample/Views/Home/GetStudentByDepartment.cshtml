@model IEnumerable<Student>
@{
    var students = ViewData["Students"] as IEnumerable<Student>;
}
<h4>Bölüme Göre Öğrenci Listele</h4>
<form method="POST" action="@Url.Action("GetStudentByDepartment","Home")">
    <div class="form-control">
        <label class="form-label" for="department">Bölüm:</label>
        <input type="text" id="departmen" name="department" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Öğrenci Getir</button>
</form>
@if(students != null && students.Any())
{
<div class="text-center">
    <table class="table">
        <thead>
            <tr>
                <th>Adı</th>
                <th>Yaşı</th>
                <th>Bölüm</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in students)
            {
                <tr>
                    <td>@student.Name</td>
                    <td>@student.Age</td>
                    <td>@student.Department</td>
                </tr>
            }
        </tbody>
    </table>
</div>
}
else{
    <div class="text-center">
        <h4>Öğrenci yok</h4>
    </div>
}
